# PromptShield Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Server ---
HOST=127.0.0.1
PORT=8000
DEBUG=false

# --- CORS ---
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Detection ---
# Maximum number of characters allowed in a single analysis request.
MAX_INPUT_LENGTH=10000

# Maximum number of items in a batch request.
MAX_BATCH_SIZE=50

# Risk score thresholds (0-100). Customize to tune sensitivity.
# LOW: 0–LOW_THRESHOLD, MEDIUM: LOW–MEDIUM_THRESHOLD, etc.
LOW_THRESHOLD=25
MEDIUM_THRESHOLD=50
HIGH_THRESHOLD=75

# --- ML Model ---
# Path to the directory where trained model artifacts are stored.
MODEL_DIR=backend/models

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- File Upload ---
# Maximum file size for batch uploads (bytes). Default: 1 MB
MAX_UPLOAD_BYTES=1048576
